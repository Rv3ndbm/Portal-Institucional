# ============================================================
# POLÍTICAS DE SEGURIDAD Y CONTROL DE ACCESO GLOBAL
# Portal Web Institucional - I.E. Gilberto Alzate Avendaño
# ============================================================

# 1. Desactivar el listado de directorios en todo el sitio
Options -Indexes

# 2. Bloquear la descarga de archivos sensibles del sistema
<FilesMatch "\.(sql|log|ini|env|bak|config|sh|bash|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Bloquear acceso a directorios ocultos (como .git)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>
